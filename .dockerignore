# Allow only application/build inputs. Never send credentials, databases, virtual
# environments, backups or unrelated workspace files to the Docker builder.
**
!Dockerfile
!.dockerignore
!backend/
!backend/**
!models.py
!alembic.ini
!pytest.ini
!migrations/
!migrations/**
!embedding_service/
!embedding_service/**
!tests/
!tests/**
!Data/edgecase.json
!Data/
!Data/products.json
!Data/policies.json
!Data/product_image_catalog.json
!Data/product_image_rag.json
!Data/policy_translations.json
!Data/policy_faqs.json
!product Image/
!product Image/**
!scripts/
!scripts/**
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/admin.html
!frontend/vite.config.js
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
**/*.db
**/*.db-*
**/*.sqlite*
