# If usin
GOOGLE_API_KEY=

# If using Groq (Recommended for free/fast Llama 3)
GROQ_API_KEY=
GROQ_API_KEY1=
#OpenRouterKey
OpenRouterKey=
Deepseek_API_Key=
#huggingfaceKey
HUGGINGFACEHUB_API_TOKEN=



# Email credentials for Admin Notification Tool
EMAIL_SENDER=bappydebath2001@gmail.com
EMAIL_PASSWORD=
ADMIN_EMAIL=bappynath2001@gmail.com

# Twilio credentials for SMS notifications

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER= # Twilio এর দেওয়া নম্বরটি

#Ngrok token
NGROK_AUTH_TOKEN=

# OmniCart v2 (FastAPI + React)
# Meta Messenger (secrets belong only in .env / deployment environment)
VERIFY_TOKEN=omnichat_bappys_4001-try
PAGE_ACCESS_TOKEN=
# Required for POST signatures; from Meta App settings > Basic (not the page token).
APP_SECRET=
# Recommended: restrict signed events to the connected Facebook Page ID.
FACEBOOK_PAGE_ID=

# Messenger copilot (see docs/copilot.md)
# cards = Generic Template carousel with "Order Now" / "More Details"; image = native photo only.
MESSENGER_PRODUCT_DISPLAY=cards
# Optional Meta Handover Protocol: pass escalated threads to this app (Page Inbox = 263902037430900).
META_HANDOVER_TARGET_APP_ID=
# Quantities at or above this go to a human as a bulk/custom order.
BULK_ORDER_THRESHOLD=50
# Optional instant admin alerts for escalations and new Messenger orders.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Any HTTPS endpoint (Slack/n8n/Zapier...) receives a JSON alert payload.
ADMIN_ALERT_WEBHOOK_URL=

# Optional: default is the existing ecommerce_saas.db in the project root.
# DATABASE_URL=sqlite:///E:/path/to/ecommerce_saas.db
# PostgreSQL: change DATABASE_URL ONLY after the migration succeeds.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@REACHABLE_HOST:5432/omnichat
# Existing Neon database (preserve both TLS options from your connection string):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/omnichat-db?sslmode=require&channel_binding=require
# DATABASE_REQUIRE_POSTGRES=true
# Check/import it with backend.migrate_postgres --use-database-url (see README).
# Administrative connection is used only by backend.migrate_postgres, not by the app.
POSTGRES_ADMIN_URL=
POSTGRES_DATABASE=omnichat
# Docker Compose starts PostgreSQL automatically. Set a strong password before up.
# These settings do not change your local DATABASE_URL or migrate existing data.
POSTGRES_USER=omnicart
POSTGRES_PASSWORD=
# Optional existing PostgreSQL server override for Docker Compose only:
# DOCKER_DATABASE_URL=postgresql+psycopg://USER:URL_ENCODED_PASSWORD@HOST:5432/omnichat
# Render: set DATABASE_URL to the managed Postgres Internal Database URL in its
# dashboard, not DOCKER_DATABASE_URL. See docs/render.md or use render.yaml.
SHOP_ID=shop_01
CHAT_MODEL=openai/gpt-oss-120b
LLM_SMALL_MODEL=openai/gpt-oss-20b
VISION_MODEL=qwen/qwen3.8-27b
STT_MODEL=whisper-large-v3-turbo

# Additional provider fallback (optional; no keys are sent to the browser)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
HF_CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct
# Vision fallbacks for photo search. VISION_PROVIDER=groq|openai|gemini chooses which runs first.
VISION_PROVIDER=groq
OPENAI_VISION_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash

# Multilingual dense search warms in the background; lexical search always works.
RAG_DENSE_ENABLED=true
RAG_MIN_CONFIDENCE=0.45
RAG_DENSE_MIN_SIMILARITY=0.40

# Route Graph RAG's typed database reads through the local MCP stdio server.
# Keep false for the lowest-latency single-process deployment; both paths use
# the same read-only gateway and the same configured database.
MCP_ENABLED=false
MCP_SHOP_ID=shop_01
MCP_TIMEOUT=20
DEEPSEEK_CHAT_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# Approximate USD per million tokens used by the admin cost dashboard.
# DeepSeek defaults use conservative peak Flash rates; override with your invoice.
DEEPSEEK_INPUT_COST_PER_M=0.30
DEEPSEEK_CACHED_INPUT_COST_PER_M=0.006
DEEPSEEK_OUTPUT_COST_PER_M=1.20
GROQ_120B_INPUT_COST_PER_M=0.15
GROQ_120B_CACHED_INPUT_COST_PER_M=0.075
GROQ_120B_OUTPUT_COST_PER_M=0.60
GROQ_20B_INPUT_COST_PER_M=0.075
GROQ_20B_CACHED_INPUT_COST_PER_M=0.0375
GROQ_20B_OUTPUT_COST_PER_M=0.30
GROQ_QWEN_INPUT_COST_PER_M=0.80
GROQ_QWEN_CACHED_INPUT_COST_PER_M=0.40
GROQ_QWEN_OUTPUT_COST_PER_M=4.00
CONTEXT_MAX_CHARS=12000
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Keep false to use only locally cached models; opt in to a first-time download.
EMBEDDING_ALLOW_DOWNLOAD=false

# Sending real emails is opt-in. Existing SMTP credentials are reused if enabled.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
